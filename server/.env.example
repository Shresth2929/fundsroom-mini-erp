# Database Configuration
# Runtime URL — use Supabase connection pooler (port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL — used by Prisma migrate only (port 5432)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Server Port
PORT=5000

# Authentication Secret
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
